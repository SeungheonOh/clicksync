CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_HTTP_PORT=18125
CLICKHOUSE_USER=clicksync
CLICKHOUSE_PASSWORD=replace-with-a-long-random-secret
CLICKHOUSE_DATABASE=clicksync

CARDANO_NETWORK_NAME=mainnet
CARDANO_NETWORK_MAGIC=764824073
CARDANO_PEERS=backbone.cardano.iog.io:3001,backbone.mainnet.cardanofoundation.org:3001
CARDANO_CORROBORATION=2

CLICKSYNC_START=intersection
CLICKSYNC_START_POINT=
CLICKSYNC_MAX_BLOCKS=0
CLICKSYNC_STOP_AT_TIP=false
CLICKSYNC_QUEUE_CAPACITY=4
CLICKSYNC_LOCK_PATH=/var/lib/clicksync-state/writer.lock
CLICKSYNC_WRITER_COORDINATION=single-host-flock
CLICKSYNC_ACTIVE_DATA_LIMIT_BYTES=75161927680
CLICKSYNC_WARNING_BYTES=64424509440
CLICKSYNC_PROJECT_LIMIT_BYTES=107374182400
