CARDANO_NETWORK_MAGIC=764824073
# Used by the optional Ogmios compose sidecar. Its known network magic must
# match the value above: mainnet=764824073, preprod=1, preview=2.
CARDANO_NETWORK=mainnet

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=clicksync
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_REQUEST_TIMEOUT_MS=30000

OGMIOS_HOST=127.0.0.1
OGMIOS_PORT=1337
OGMIOS_TLS=false
OGMIOS_CONNECT_TIMEOUT_MS=30000
OGMIOS_IN_FLIGHT=20
OGMIOS_MAX_PAYLOAD_BYTES=134217728

CLICKSYNC_INTERSECTION_CANDIDATES=4096
CLICKSYNC_BATCH_BLOCKS=250
CLICKSYNC_MAX_ROLLBACK_DEPTH=2160
CLICKSYNC_SCHEMA_DIR=schema
LOG_LEVEL=info
LOG_PRETTY=true
