{
  "name": "clicksync",
  "version": "0.1.0",
  "private": true,
  "description": "Append-only Cardano chain indexer for ClickHouse",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts sync",
    "start": "node dist/src/cli.js sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "CLICKHOUSE_INTEGRATION=1 vitest run test/clickhouse.integration.test.ts"
  },
  "dependencies": {
    "@cardano-ogmios/client": "7.0.0",
    "@cardano-ogmios/schema": "7.0.0",
    "@clickhouse/client": "1.23.1",
    "commander": "14.0.0",
    "pino": "9.7.0",
    "pino-pretty": "13.1.1"
  },
  "devDependencies": {
    "@types/node": "24.0.13",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
